# Copy to .env and adjust before running services locally or with Docker Compose.
#   cp .env.example .env

# --- shared ---------------------------------------------------------------
LOG_LEVEL=info
AUTO_MIGRATE=true

# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=fayrly-dev-jwt-secret-change-me-0123456789abcdef
JWT_ISSUER=fayrly
JWT_AUDIENCE=fayrly-api
ACCESS_TOKEN_TTL=15m

# Shared secret for service-to-service calls (X-Internal-Key).
INTERNAL_API_KEY=fayrly-dev-internal-key-change-me-0123456789

# --- gateway --------------------------------------------------------------
GATEWAY_ADDR=:8080
GATEWAY_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_MAX_AGE=10m
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# --- databases ------------------------------------------------------------
POSTGRES_USER=fayrly
POSTGRES_PASSWORD=fayrly
# If 5432 is already in use, change POSTGRES_PORT and the URLs below together.
POSTGRES_PORT=5432

USER_DATABASE_URL=postgres://fayrly:fayrly@localhost:5432/fayrly_user?sslmode=disable
AUTH_DATABASE_URL=postgres://fayrly:fayrly@localhost:5432/fayrly_auth?sslmode=disable
EVENT_DATABASE_URL=postgres://fayrly:fayrly@localhost:5432/fayrly_event?sslmode=disable
REPORT_DATABASE_URL=postgres://fayrly:fayrly@localhost:5432/fayrly_report?sslmode=disable

# --- service addresses (local development) --------------------------------
AUTH_ADDR=:8081
USER_ADDR=:8082
EVENT_ADDR=:8083
REPORT_ADDR=:8084

AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
EVENT_SERVICE_URL=http://localhost:8083
REPORT_SERVICE_URL=http://localhost:8084

# --- auth -----------------------------------------------------------------
REFRESH_TOKEN_TTL=720h

# Optional Firebase project ID. When empty, /auth/firebase returns 503.
FIREBASE_PROJECT_ID=

# --- password reset email -------------------------------------------------
# auto|resend: send with Resend when RESEND_API_KEY is set, otherwise disabled.
# log: print emails to the service log instead of sending them (development only).
MAIL_MODE=auto
RESEND_API_KEY=
MAIL_FROM="Fayrly <no-reply@fayrly.local>"

# Optional first superadmin. Applied only when the email has no credential yet.
BOOTSTRAP_ADMIN_EMAIL=admin@fayrly.local
BOOTSTRAP_ADMIN_PASSWORD=FayrlyAdmin123!
BOOTSTRAP_ADMIN_NAME="Platform Owner"
