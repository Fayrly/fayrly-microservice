    {
      "name": "Events",
      "item": [
        {
          "name": "List Events (publik)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/events?page=1&page_size=20",
            "description": "Tanpa token hanya menampilkan status published/ongoing/completed. Filter: q, type, city, status, from, to, page, page_size."
          }
        },
        {
          "name": "List My Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/events/mine?page=1&page_size=20",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{access_token}}", "type": "string" }
              ]
            }
          }
        },
        {
          "name": "Create Event (charity)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"create event 201\", function () { pm.response.to.have.status(201); });",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"event_id\", b.data.id);",
                  "pm.test(\"event draft dengan tags\", function () {",
                  "  pm.expect(b.data.status).to.eql(\"draft\");",
                  "  pm.expect(b.data.tags).to.include(\"charity\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"Fayrly Charity Night {{$timestamp}}\", \"description\": \"Konser amal tahunan\", \"type\": \"charity\", \"venue_name\": \"Grand Hall\", \"venue_address\": \"Jl. Sudirman 1\", \"city\": \"Jakarta\", \"country\": \"ID\", \"starts_at\": \"2027-06-01T19:00:00+07:00\", \"ends_at\": \"2027-06-01T22:00:00+07:00\", \"capacity\": 500, \"price_min\": 100000, \"price_max\": 500000, \"currency\": \"IDR\", \"cover_image_url\": \"https://example.com/cover.jpg\", \"organizer_name\": \"Fayrly\", \"contact_email\": \"events@fayrly.local\", \"contact_phone\": \"+6281200000000\", \"tags\": [\"charity\", \"music\"], \"beneficiary\": \"Yayasan Harapan\", \"donation_target\": 50000000}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/events",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{access_token}}", "type": "string" }
              ]
            },
            "description": "Butuh event:write. slug opsional (otomatis). type charity wajib beneficiary."
          }
        },
        {
          "name": "Get Event",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/events/{{event_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{access_token}}", "type": "string" }
              ]
            },
            "description": "Terima UUID atau slug. Tanpa token hanya event published/ongoing/completed yang terlihat; dengan event:read draft juga bisa diambil."
          }
        },
        {
          "name": "Update Event",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"venue_name\": \"Grand Hall 2\", \"capacity\": 650}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/events/{{event_id}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{access_token}}", "type": "string" }
              ]
            },
            "description": "Hanya bisa saat draft/published/ongoing."
          }
        },
        {
          "name": "Publish Event",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"publish 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"status published\", function () { pm.expect(pm.response.json().data.status).to.eql(\"published\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"published\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/events/{{event_id}}/status",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{access_token}}", "type": "string" }
              ]
            },
            "description": "Transisi: draft → published."
          }
        },
        {
          "name": "Move Event to Ongoing",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"ongoing\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/events/{{event_id}}/status",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{access_token}}", "type": "string" }
              ]
            },
            "description": "Transisi: published → ongoing."
          }
        },
        {
          "name": "Complete Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"status\": \"completed\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/events/{{event_id}}/status",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{access_token}}", "type": "string" }
              ]
            },
            "description": "Transisi: ongoing → completed. Setelah completed, event terkunci dari edit."
          }
        }
      ]
