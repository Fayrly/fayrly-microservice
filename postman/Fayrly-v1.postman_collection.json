{
  "info": {
    "_postman_id": "f1a5c0de-0001-4a00-8000-000000000001",
    "name": "Fayrly v1 API",
    "description": "Collection end-to-end untuk backend Fayrly v1 lewat gateway :8080.\n\nUrutan folder: Auth → Users → Roles → Events → Reports → Cleanup → Health. Jalankan lewat Collection Runner agar token dan ID terisi otomatis.\n\nPrasyarat: stack lokal menyala (docker compose up -d) dan environment \"Fayrly Local\" dipilih.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"register 201\", function () { pm.response.to.have.status(201); });",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"member_token\", b.access_token);",
                  "pm.collectionVariables.set(\"member_id\", b.user.id);",
                  "pm.collectionVariables.set(\"access_token\", b.access_token);",
                  "pm.collectionVariables.set(\"refresh_token\", b.refresh_token);",
                  "pm.test(\"session berisi token\", function () {",
                  "  pm.expect(b.access_token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(b.user.roles).to.include(\"member\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"member-{{$timestamp}}@fayrly.local\", \"password\": \"Member123!\", \"name\": \"Member Postman\", \"phone\": \"+6281212345678\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/auth/register",
            "description": "Publik. Membuat akun member dengan email unik per run. Token member disimpan ke member_token."
          }
        },
        {
          "name": "Login Superadmin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"login 200\", function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", b.access_token);",
                  "pm.collectionVariables.set(\"refresh_token\", b.refresh_token);",
                  "pm.test(\"superadmin punya semua permission\", function () {",
                  "  pm.expect(b.access_token).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(b.user.roles).to.include(\"superadmin\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{admin_email}}\", \"password\": \"{{admin_password}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "Publik. Login bootstrap superadmin dari environment."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"refresh 200\", function () { pm.response.to.have.status(200); });",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"access_token\", b.access_token);",
                  "pm.collectionVariables.set(\"refresh_token\", b.refresh_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"refresh_token\": \"{{refresh_token}}\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/auth/refresh",
            "description": "Rotasi refresh token. Token lama langsung tidak berlaku (reuse detection)."
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{access_token}}", "type": "string" }
              ]
            },
            "description": "Profil + roles + permissions dari token aktif."
          }
        },
        {
          "name": "Change Member Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"password 200/204\", function () {",
                  "  pm.expect([200, 204]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"current_password\": \"Member123!\", \"new_password\": \"Member456!\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/auth/password",
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{member_token}}", "type": "string" }
              ]
            },
            "description": "Menggunakan token member hasil Register, jadi password admin tidak berubah."
          }
        },
        {
          "name": "Firebase Login (butuh konfigurasi)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"id_token\": \"<firebase_id_token>\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/api/v1/auth/firebase",
            "description": "Mengembalikan 503 selama FIREBASE_PROJECT_ID belum diisi. Isi id_token asli untuk menguji login Firebase."
          }
        }
      ]
    },
